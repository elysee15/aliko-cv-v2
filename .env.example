# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# The database URL is used to connect to your Supabase database.
POSTGRES_URL="postgres://postgres.[USERNAME]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel"

# Supabase project handles (storage, realtime). Auth sessions are owned by
# Better Auth, not by Supabase Auth — these keys are only for the data plane.
# @see https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=''
# Server-only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=''

# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# Google OAuth provider. The authorised redirect URI must be the *production*
# origin (`https://<prod-domain>/api/auth/callback/google`) — oAuthProxy routes
# preview deployments through it.
# @see https://www.better-auth.com/docs/authentication/google
AUTH_GOOGLE_ID=''
AUTH_GOOGLE_SECRET=''

# Transactional e-mail (password reset, address confirmation).
# Leave RESEND_API_KEY empty in development: the links are logged to the server
# console instead of being sent.
# @see https://resend.com/api-keys
RESEND_API_KEY=''
EMAIL_FROM='Aliko <bonjour@exemple.fr>'
