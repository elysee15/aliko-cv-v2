{
  "name": "@aliko/email",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./env.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "@react-email/render": "catalog:",
    "@t3-oss/env-core": "^0.13.8",
    "resend": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aliko/eslint-config": "workspace:*",
    "@aliko/prettier-config": "workspace:*",
    "@aliko/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react19"
  },
  "prettier": "@aliko/prettier-config"
}
